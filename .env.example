GHIDRA_INSTALL_DIR=/opt/ghidra
GHIDRA_MCP_ANALYSIS_TIMEOUT_SECONDS=300
# 并发 JVM worker 线程数（1 表示沿用单线程所有权）。
GHIDRA_MCP_MAX_WORKERS=1
GHIDRA_MCP_TRANSPORT=stdio
# HTTP 模式还需设置允许读取的输入根目录。
# GHIDRA_MCP_INPUT_ROOT=/data/input
# GHIDRA_MCP_PUBLIC_URL=http://127.0.0.1:8765
# 至少 32 个 UTF-8 字节，且不允许首尾空白。
# GHIDRA_MCP_AUTH_TOKEN=replace-with-at-least-32-random-bytes
